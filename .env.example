# Copy to .env (chmod 600) and fill in. .env is git-ignored.
#
# Tenable requires a descriptive User-Agent that identifies the integration and
# a contact Tenable can reach if a support issue arises. Change the contact.

# --- Tenable Vulnerability Management (cloud.tenable.com) -----------------
TENABLE_BASE_URL=https://cloud.tenable.com
TENABLE_ACCESS_KEY=replace-with-access-key
TENABLE_SECRET_KEY=replace-with-secret-key
TENABLE_USER_AGENT="SecOps-Autopilot/0.2.0 (SWARM-Tenable-Hackathon; security-team@example.com)"

# Optional second tenant/profile, selected with --profile alt
TENABLE_ALT_ACCESS_KEY=
TENABLE_ALT_SECRET_KEY=
TENABLE_ALT_USER_AGENT=

# --- Tenable Security Center (appliance) ----------------------------------
# The adapter follows the documented /rest API; no SC appliance is required
# for the Vulnerability Management path.
TENABLE_SC_URL=
TENABLE_SC_ACCESS_KEY=
TENABLE_SC_SECRET_KEY=
TENABLE_SC_USER_AGENT=
TENABLE_SC_VERIFY_TLS=true

# --- Cisco ISE ERS (optional; simulated when empty) -----------------------
ISE_URL=
ISE_USERNAME=
ISE_PASSWORD=
ISE_VERIFY_TLS=true
ISE_ANC_ACTION=QUARANTINE

# --- Runtime --------------------------------------------------------------
SECOPS_RUNS_DIR=runs
SECOPS_STATE_DIR=.state
SECOPS_CACHE_DIR=.cache
SECOPS_DATE_RANGE_DAYS=90
SECOPS_ISOLATE_THRESHOLD=80
SECOPS_REMEDIATION_VLAN=999
SECOPS_QUARANTINE_POLICY=SECOPS-QUARANTINE
# Verification refuses to call an absent finding "remediated" when the asset's
# last scan is older than this. Stale/unknown freshness becomes `unknown`.
SECOPS_VERIFICATION_MAX_SCAN_AGE_HOURS=72
